{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RubixKube Docs",
  "description": "RubixKube watches your infrastructure and connected tools, turns what breaks into incidents, and Rubix investigates each one and suggests the fix.",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1E3A8A"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "description": "RubixKube watches your infrastructure and connected tools, turns what breaks into incidents, and Rubix investigates each one and suggests the fix.",
      "author": "RubixKube",
      "robots": "index, follow",
      "googlebot": "index, follow",
      "theme-color": "#2563EB",
      "og:site_name": "RubixKube Docs",
      "og:type": "website",
      "og:image": "/images/console/incidents-light.png",
      "twitter:card": "summary_large_image",
      "twitter:site": "@RubixKubeHQ",
      "twitter:creator": "@RubixKubeHQ"
    }
  },
  "navigation": {
    "tabs": [
